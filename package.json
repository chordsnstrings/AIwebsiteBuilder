{
  "name": "adw",
  "version": "1.0.0",
  "private": true,
  "description": "ADW \u2014 Autonomous Website Foundry",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "bash scripts/dev-db.sh start",
    "db:stop": "bash scripts/dev-db.sh stop",
    "db:reset": "bash scripts/dev-db.sh reset",
    "db:migrate": "tsx scripts/migrate.ts",
    "vault:init": "bash scripts/init-vault.sh",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:pg": "ADW_DB=pg vitest run",
    "build": "turbo run build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "seed": "tsx scripts/seed-demo.ts",
    "demo": "bash scripts/demo.sh",
    "demo:e2e": "tsx scripts/demo-e2e.ts",
    "eval:nightly": "tsx scripts/eval-nightly.ts",
    "dev": "turbo run dev",
    "lighthouse": "node scripts/lighthouse-all.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.18.0",
    "lighthouse": "^13.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.19.2",
    "turbo": "^2.10.7",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.32",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

# ADW environment configuration.
# In demo/keyless mode, none of the vendor keys below are required — the system
# selects mock adapters when a credential is absent from the vault. Deposit real
# credentials through the superadmin Settings/Vault surface to go live.

ADW_ENV=local                 # local | test | staging | production
ADW_DB=pg                     # pg | pglite
DATABASE_URL=postgres://adw_app:adw@127.0.0.1:5433/adw
DATABASE_ADMIN_URL=postgres://adw_admin@127.0.0.1:5433/adw
REDIS_URL=redis://127.0.0.1:6379

# Vault master key (32 bytes hex). Generated by scripts/init-vault.sh in demo.
# In production this is supplied by a real KMS/secrets backend.
ADW_VAULT_MASTER_KEY=

# Superadmin bootstrap (demo only — rotate immediately in production)
ADW_SUPERADMIN_EMAIL=admin@adw.example
ADW_SUPERADMIN_PASSWORD=changeme-in-production

# --- Vendor credentials (all optional in demo mode; deposit via Vault UI) ---
# MODELARK_API_KEY=
# GOOGLE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CLOUDFLARE_API_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
